GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
# Required. Must match the Webhook secret configured on the GitHub App; incoming
# webhooks are HMAC-verified against it. The App's Webhook URL should point at
# <public-host>/webhook (e.g. an ngrok tunnel to localhost:8000 in dev).
GITHUB_WEBHOOK_SECRET=

GITHUB_REDIRECT_URL=http://localhost:8000/github/callback

QUISAC_SESSION_SECRET=

# PostgreSQL credentials used by docker compose to provision the local instance.
POSTGRES_USER=quisac
POSTGRES_PASSWORD=quisac
POSTGRES_DB=quisac

# PostgreSQL connection string. Run `docker compose up -d` to start a matching
# local instance (schema applied automatically on first boot). Keep the
# user/password/db in sync with the POSTGRES_* values above.
DATABASE_URL=postgres://quisac:quisac@localhost:5432/quisac?sslmode=disable

# Neo4j — the code-graph store. For a local Neo4j Desktop instance, start a DBMS
# and use the bolt/neo4j port it exposes (default 7687). NEO4J_USER is usually
# "neo4j"; NEO4J_PASSWORD is whatever you set when creating the DBMS.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# HTTP port
PORT=8000
