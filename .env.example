# GitHub App — values from your app's settings page:
# https://github.com/settings/apps/<your-app>
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Where GitHub sends the user back after install + authorize.
# Must match the "Callback URL" / "Setup URL" in the app settings.
GITHUB_REDIRECT_URL=http://localhost:8000/api/github/callback

# Random 32+ byte string used to sign session cookies.
QUISAC_SESSION_SECRET=

# HTTP port
PORT=8000
