GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The App's PEM, newlines included. Quote it so the block survives as one value.
GITHUB_APP_PRIVATE_KEY=""

# Must match the Webhook secret configured on the GitHub App; incoming webhooks
# are HMAC-verified against it. The App's Webhook URL should point at
# <public-host>/webhook (e.g. an ngrok tunnel to localhost:8000 in dev).
GITHUB_WEBHOOK_SECRET=

GITHUB_REDIRECT_URL=http://localhost:8000/github/callback

QUISAC_SESSION_SECRET=

# The signing secret of the PagerDuty webhook subscription. Deliveries whose
# signature does not match are rejected with 401. Leave it unset only in local
# dev: unset, deliveries are accepted unverified, and anyone who can reach the
# endpoint can spend model tokens and open pull requests.
PAGERDUTY_WEBHOOK_SECRET=

POSTGRES_USER=quisac
POSTGRES_PASSWORD=quisac
POSTGRES_DB=quisac

# PostgreSQL connection string (used only when running the app on the host). The
# app applies its schema migrations automatically on boot — no manual step.
DATABASE_URL=postgres://quisac:quisac@localhost:5432/quisac?sslmode=disable

NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=quisacpass

# HTTP port
PORT=8000

# ─── Incident resolution ─────────────────────────────────────────────────────
# Everything below is optional. Without it, alerts are still ingested, traced
# through the code graph, and matched against previously-recorded fixes — novel
# incidents simply stop at a ranked root-cause analysis instead of a patch.

# The model that writes fixes. Setting a key enables tier 3: writing a patch for
# an incident the pattern cache has never seen. Leave both keys empty and the
# pipeline still ingests alerts, walks the graph, and replays known fixes.
#
# Which provider is used follows QUISAC_LLM_PROVIDER. With it unset, whichever
# key you set decides — set only one unless you are switching between them.
# QUISAC_LLM_PROVIDER=anthropic

# Anthropic (billed from prepaid API credits, separate from any Claude
# subscription — a Pro or Max plan grants no API credit).
ANTHROPIC_API_KEY=

# Google Gemini. Key: https://aistudio.google.com/apikey
# The default model is on Gemini's free tier. Google uses free-tier requests to
# improve their products, and this pipeline sends source code and production
# stack traces — use a billed key for anything but your own code.
GEMINI_API_KEY=

# Model and reasoning effort. Effort is low | medium | high | xhigh | max and
# maps onto each provider's own control, so it means the same thing either way.
# Model defaults per provider: claude-opus-5, gemini-3.5-flash. Effort: xhigh.
# Newer Gemini ids are listed for free-tier keys but answer 503 UNAVAILABLE;
# reaching them needs a billed key.
# QUISAC_LLM_MODEL=
# QUISAC_LLM_EFFORT=xhigh

# Whether a validated fix is pushed and opened as a pull request automatically.
# Defaults to true, paired with draft pull requests so a machine-authored change
# lands somewhere visible but cannot be merged by reflex.
# Requires the GitHub App to hold `contents: write` and `pull_requests: write`.
# QUISAC_AUTO_PR=true
# QUISAC_DRAFT_PR=true

# Branch namespace for generated fixes: quisac/<incident-id>.
# QUISAC_BRANCH_PREFIX=quisac

# A proposed fix below this confidence is reported but never opened as a PR.
# QUISAC_MIN_CONFIDENCE=0.5

# How many files the graph may hand the model, and how many hops the backward
# graph walk takes from the failure.
# QUISAC_MAX_FIX_FILES=3
# QUISAC_MAX_DEPTH=5
