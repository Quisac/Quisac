GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
# Required. Must match the Webhook secret configured on the GitHub App; incoming
# webhooks are HMAC-verified against it. The App's Webhook URL should point at
# <public-host>/webhook (e.g. an ngrok tunnel to localhost:8000 in dev).
GITHUB_WEBHOOK_SECRET=

GITHUB_REDIRECT_URL=http://localhost:8000/github/callback

QUISAC_SESSION_SECRET=

# --- Datastores -------------------------------------------------------------
# With `docker compose up` you normally DON'T touch DATABASE_URL / NEO4J_URI:
# compose starts Postgres + Neo4j and injects connection strings pointing at the
# service names, overriding the values below. The POSTGRES_* / NEO4J_* values
# here are what compose uses to provision those instances.
#
# Running the app on the host instead (`make dev`)? Then DATABASE_URL / NEO4J_URI
# must point at reachable instances (localhost:5432 / localhost:7687 below).

# PostgreSQL credentials used by docker compose to provision the local instance.
POSTGRES_USER=quisac
POSTGRES_PASSWORD=quisac
POSTGRES_DB=quisac

# PostgreSQL connection string (used only when running the app on the host). The
# app applies its schema migrations automatically on boot — no manual step.
DATABASE_URL=postgres://quisac:quisac@localhost:5432/quisac?sslmode=disable

# Neo4j — the code-graph store. The app applies its own constraints on startup.
# Password must be at least 8 characters. Under compose this provisions the DBMS;
# on the host, point NEO4J_URI at a running instance (default bolt port 7687).
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=quisacpass

# HTTP port
PORT=8000
